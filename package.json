{
  "name": "obsidian-publisher",
  "version": "1.0.0",
  "description": "Publish Obsidian notes to GitHub for Hugo processing",
  "main": "main.js",
  "scripts": {
    "dev": "bun build src/main.ts --outfile=main.js --target=node --format=cjs --external=obsidian --external=electron --watch --sourcemap=inline",
    "build": "bun run typecheck && bun run check && bun build src/main.ts --outfile=main.js --target=node --format=cjs --external=obsidian --external=electron --minify",
    "build:dev": "bun build src/main.ts --outfile=main.js --target=node --format=cjs --external=obsidian --external=electron --sourcemap=inline",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate-plugin.ts",
    "version": "bun run version-bump.ts",
    "prepublishOnly": "bun run validate"
  },
  "keywords": ["obsidian", "obsidian-plugin", "hugo", "github", "publishing"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.10.5",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1"
  }
}
